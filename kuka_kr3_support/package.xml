<?xml version="1.0"?>
<package format="3">
  <name>kuka_kr3_support</name>
  <version>0.1.0</version>
  <description>
    <p>ROS 2 support for the KUKA KR 3 (and variants).</p>
    <p>
      This package contains configuration data, 3D models, and launch files
      for the KUKA KR 3 manipulators, specifically the R540 model.
    </p>
    <p><b>Specifications:</b></p>
    <ul>
      <li>KR 3 R540 - Default</li>
    </ul>
    <p>
      Joint limits and maximum joint velocities are based on the
      <em>KUKA Roboter GmbH - KR 3 AGILUS Specification</em> (Version: Spez KR 3 AGILUS V3, 21.03.2017).
    </p>
    <p>
      Before using any of the configuration files and/or meshes in this package, ensure they are correct for your robot model.
    </p>
  </description>

  <author>Brett Hemes (3M)</author>
  <maintainer email="g.a.vanderhoorn@tudelft.nl">G.A. vd. Hoorn (TU Delft Robotics Institute)</maintainer>
  <license>BSD</license>

  <url type="website">http://wiki.ros.org/kuka_kr3_support</url>
  <url type="bugtracker">https://github.com/ros-industrial/kuka_experimental/issues</url>
  <url type="repository">https://github.com/ros-industrial/kuka_experimental</url>

  <!-- Build tool dependency for ROS 2 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Execution dependencies -->
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>kuka_resources</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>  <!-- Added for URDF parsing in ROS 2 -->
  <exec_depend>launch</exec_depend>  <!-- Needed for ROS 2 launch files -->
  <exec_depend>launch_ros</exec_depend>  <!-- Needed for ROS 2 launch system -->

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>  <!-- Replaces roslaunch -->

  <export>
    <build_type>ament_cmake</build_type>
    <metapackage/>
  </export>
</package>